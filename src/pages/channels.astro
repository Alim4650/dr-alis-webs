---
import Layout from '../layouts/Layout.astro';
import { channelGroups, getChannelsByGroup } from '../data/channels';
---

<Layout title="القنوات">
    <section class="py-8 text-center sm:py-12">
        <h1 class="mb-3">📺 القنوات</h1>
        <p class="text-lg text-gray-300">جميع القنوات المتاحة للبث المباشر</p>
    </section>

    {
        channelGroups.map((group) => {
            const list = getChannelsByGroup(group.key);
            if (list.length === 0) return null;
            return (
                <section class="mb-12">
                    <div class="mb-5 flex items-center gap-2">
                        <span class="text-2xl">{group.icon}</span>
                        <h2 class="text-xl sm:text-2xl">{group.label}</h2>
                        <span class="text-sm text-gray-500">({list.length})</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                        {list.map((channel) => (
                            <div
                                data-channel-card
                                tabindex="0"
                                class="group flex cursor-pointer flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 text-center transition hover:border-white/30 hover:bg-white/10 focus:outline-none"
                            >
                                <div
                                    class="flex h-14 w-14 items-center justify-center rounded-xl text-lg font-bold text-white shadow-lg"
                                    style={`background-color: ${channel.accent}`}
                                >
                                    {channel.name.replace(/[^0-9]/g, '').slice(0, 2) || '📺'}
                                </div>
                                <span class="text-sm font-semibold leading-tight">{channel.name}</span>
                            </div>
                        ))}
                    </div>
                </section>
            );
        })
    }

    <p class="mt-8 rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-center text-sm text-amber-200">
        ⚠️ روابط البث تُضاف من لوحة التحكم الخاصة بك — هذه القائمة تعرض القنوات وتصنيفاتها فقط.
    </p>
</Layout>
