---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer.tsx';
import { matches, getMatchById } from '../../data/matches';

// توليد صفحة لكل مباراة قابلة للمشاهدة عند البناء
export function getStaticPaths() {
    return matches
        .filter((m) => m.status === 'live' && m.streamUrl)
        .map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const match = getMatchById(id!);

// في حال عدم وجود المباراة أو عدم توفّر البث
if (!match || !match.streamUrl) {
    return Astro.redirect('/');
}

const title = `${match.home.name} ضد ${match.away.name}`;
---

<Layout title={title}>
    <section class="py-6">
        <a href="/" class="mb-6 inline-block text-sm text-gray-400 no-underline hover:text-primary">
            ← العودة للمباريات
        </a>

        <div class="mb-4 text-center">
            <span class="text-xs text-gray-400">{match.league}</span>
            <h1 class="mt-1 text-2xl sm:text-3xl">
                {match.home.logo} {match.home.name}
                <span class="mx-2 text-gray-500">ضد</span>
                {match.away.name} {match.away.logo}
            </h1>
            {
                match.score && (
                    <p class="mt-2 text-3xl font-extrabold tracking-widest text-primary">
                        {match.score.home} - {match.score.away}
                    </p>
                )
            }
        </div>

        <!-- مشغّل البث (جزيرة React تفاعلية) -->
        <VideoPlayer client:only="react" src={match.streamUrl} />

        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm text-gray-300">
            {match.channel && <span>📺 {match.channel}</span>}
            {match.commentator && <span>🎙️ {match.commentator}</span>}
            <span class="flex items-center gap-1.5">
                <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-600 animate-pulse"></span>
                بث مباشر
            </span>
        </div>
    </section>
</Layout>
